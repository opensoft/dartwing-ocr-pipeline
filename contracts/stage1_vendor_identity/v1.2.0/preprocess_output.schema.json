{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgerlinc.local/contracts/stage1_vendor_identity/v1.0.0/preprocess_output.schema.json",
  "title": "preprocess_output",
  "description": "Deterministic OCR + layout output for one stage 1 document. Trijunction-ready.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_set_version",
    "pipeline_version",
    "document_id",
    "source_type",
    "source_file",
    "page_count",
    "pages",
    "document_text",
    "tables",
    "quality",
    "ingestion_sources",
    "warnings"
  ],
  "properties": {
    "contract_set_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "document_id": { "type": "string", "minLength": 1 },
    "source_type": { "type": "string", "enum": ["pdf"] },
    "source_file": { "type": "string", "minLength": 1 },
    "page_count": { "type": "integer", "minimum": 1 },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    },
    "document_text": { "type": "string" },
    "tables": { "type": "array", "items": { "type": "object" } },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scan_quality", "skew_detected", "noise_level"],
      "properties": {
        "scan_quality": { "type": "string", "enum": ["good", "fair", "poor"] },
        "skew_detected": { "type": "boolean" },
        "noise_level": { "type": "string", "enum": ["low", "medium", "high"] }
      }
    },
    "ingestion_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paddleocr_vl", "falcon_ocr", "falcon_perception"],
      "properties": {
        "paddleocr_vl": { "$ref": "#/$defs/ingestion_source" },
        "falcon_ocr": { "$ref": "#/$defs/ingestion_source" },
        "falcon_perception": { "$ref": "#/$defs/ingestion_source" }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_number",
        "width",
        "height",
        "rotation_detected",
        "blocks",
        "raw_ocr_lines"
      ],
      "properties": {
        "page_number": { "type": "integer", "minimum": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "rotation_detected": { "type": "integer", "enum": [0, 90, 180, 270] },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } },
        "raw_ocr_lines": {
          "type": "array",
          "items": { "$ref": "#/$defs/ocr_line" }
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_id",
        "block_type",
        "bbox",
        "reading_order",
        "text",
        "confidence"
      ],
      "properties": {
        "block_id": { "type": "string", "pattern": "^p\\d+_b\\d+$" },
        "block_type": {
          "type": "string",
          "enum": ["text", "title", "table", "figure", "header", "footer"]
        },
        "bbox": { "$ref": "#/$defs/bbox" },
        "reading_order": { "type": "integer", "minimum": 1 },
        "text": { "type": "string" },
        "confidence": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "ocr_line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_id", "bbox", "text", "confidence"],
      "properties": {
        "line_id": { "type": "string", "pattern": "^p\\d+_l\\d+$" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "text": { "type": "string" },
        "confidence": { "type": ["number", "null"], "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "integer", "minimum": 0 }
    },
    "ingestion_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "status"],
      "properties": {
        "enabled": { "type": "boolean" },
        "status": {
          "type": "string",
          "enum": ["success", "failure", "not_implemented"]
        }
      }
    }
  }
}
