{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgerlinc.local/contracts/stage1_vendor_identity/v1.0.0/evaluation_run_summary.schema.json",
  "title": "evaluation_run_summary",
  "description": "Run-level aggregate across the stage 1 corpus.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_set_version",
    "run_id",
    "document_count",
    "overall_metrics",
    "consensus_metrics",
    "by_difficulty",
    "by_field",
    "documents"
  ],
  "properties": {
    "contract_set_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "run_id": { "type": "string", "minLength": 1 },
    "pipeline_version": { "type": ["string", "null"], "minLength": 1 },
    "policy_version": { "type": ["string", "null"], "minLength": 1 },
    "document_count": { "type": "integer", "minimum": 0 },
    "overall_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_accuracy",
        "vendor_identity_pass_rate",
        "review_routing_pass_rate",
        "overall_document_pass_rate"
      ],
      "properties": {
        "field_accuracy": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "vendor_identity_pass_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "review_routing_pass_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "overall_document_pass_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "consensus_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "single_voter_baseline_runs",
        "majority_vote_documents",
        "split_decision_documents"
      ],
      "properties": {
        "single_voter_baseline_runs": { "type": "integer", "minimum": 0 },
        "majority_vote_documents": { "type": "integer", "minimum": 0 },
        "split_decision_documents": { "type": "integer", "minimum": 0 },
        "unanimous_field_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "two_of_three_majority_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "split_decision_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    },
    "by_difficulty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["easy", "medium", "hard", "missing_name"],
      "properties": {
        "easy": { "$ref": "#/$defs/difficulty_stats" },
        "medium": { "$ref": "#/$defs/difficulty_stats" },
        "hard": { "$ref": "#/$defs/difficulty_stats" },
        "missing_name": { "$ref": "#/$defs/difficulty_stats" }
      }
    },
    "by_field": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "overall_passed", "field_accuracy"],
        "properties": {
          "document_id": { "type": "string", "minLength": 1 },
          "overall_passed": { "type": "boolean" },
          "field_accuracy": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
        }
      }
    }
  },
  "$defs": {
    "difficulty_stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_count", "field_accuracy", "overall_document_pass_rate"],
      "properties": {
        "document_count": { "type": "integer", "minimum": 0 },
        "field_accuracy": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "overall_document_pass_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
      }
    }
  }
}
