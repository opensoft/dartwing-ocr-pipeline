{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgerlinc.local/contracts/stage1_vendor_identity/v1.0.0/final_structured_payload.schema.json",
  "title": "final_structured_payload",
  "description": "Clean downstream handoff object. Flattened vendor_candidate (no evidence references).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_set_version",
    "pipeline_version",
    "document_id",
    "processed_at",
    "document_type",
    "vendor_candidate",
    "review_status",
    "quality_summary",
    "trace"
  ],
  "properties": {
    "contract_set_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "document_id": { "type": "string", "minLength": 1 },
    "processed_at": { "type": "string", "format": "date-time" },
    "document_type": { "type": "string", "enum": ["invoice"] },
    "vendor_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company_name",
        "address",
        "tax_ids",
        "website",
        "phone",
        "email"
      ],
      "properties": {
        "company_name": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "present", "inferred", "confidence"],
          "properties": {
            "value": { "type": ["string", "null"] },
            "present": { "type": "boolean" },
            "inferred": { "type": "boolean" },
            "confidence": { "$ref": "#/$defs/confidence" }
          }
        },
        "address": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "street_1",
            "street_2",
            "city",
            "state",
            "postal_code",
            "country"
          ],
          "properties": {
            "street_1": { "$ref": "#/$defs/value_confidence" },
            "street_2": { "$ref": "#/$defs/value_confidence" },
            "city": { "$ref": "#/$defs/value_confidence" },
            "state": { "$ref": "#/$defs/value_confidence" },
            "postal_code": { "$ref": "#/$defs/value_confidence" },
            "country": { "$ref": "#/$defs/value_confidence" }
          }
        },
        "tax_ids": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ein", "state_tax_id", "vat_id", "other_tax_id"],
          "properties": {
            "ein": { "$ref": "#/$defs/value_confidence" },
            "state_tax_id": { "$ref": "#/$defs/value_confidence" },
            "vat_id": { "$ref": "#/$defs/value_confidence" },
            "other_tax_id": { "$ref": "#/$defs/value_confidence" }
          }
        },
        "website": { "$ref": "#/$defs/value_confidence" },
        "phone": { "$ref": "#/$defs/value_confidence" },
        "email": { "$ref": "#/$defs/value_confidence" }
      }
    },
    "review_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manual_review_required", "review_reason"],
      "properties": {
        "manual_review_required": { "type": "boolean" },
        "review_reason": { "type": ["string", "null"] }
      }
    },
    "quality_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overall_vendor_confidence",
        "explicit_name_found",
        "consensus_level",
        "secondary_identifiers_found"
      ],
      "properties": {
        "overall_vendor_confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "explicit_name_found": { "type": "boolean" },
        "consensus_level": {
          "type": "string",
          "enum": ["single_voter_baseline"]
        },
        "secondary_identifiers_found": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["address", "ein", "state_tax_id", "vat_id", "other_tax_id", "website", "phone", "email"]
          }
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_file",
        "preprocess_output_file",
        "edge_extraction_output_file",
        "routing_decision_file"
      ],
      "properties": {
        "source_file": { "type": "string", "minLength": 1 },
        "preprocess_output_file": { "type": "string", "minLength": 1 },
        "edge_extraction_output_file": { "type": "string", "minLength": 1 },
        "routing_decision_file": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "value_confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence"],
      "properties": {
        "value": { "type": ["string", "null"] },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    }
  }
}
