{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledgerlinc.local/contracts/stage1_vendor_identity/v1.0.0/edge_extraction_output.schema.json",
  "title": "edge_extraction_output",
  "description": "Model-driven structured extraction. Ensemble-ready by shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_set_version",
    "pipeline_version",
    "document_id",
    "processed_at",
    "model_runtime",
    "vote_metadata",
    "document_type",
    "vendor_candidate",
    "invoice_header_fields",
    "extraction_notes",
    "warnings",
    "status"
  ],
  "properties": {
    "contract_set_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "document_id": { "type": "string", "minLength": 1 },
    "processed_at": { "type": "string", "format": "date-time" },
    "model_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model_name", "model_version", "runtime"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model_name": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 }
      }
    },
    "vote_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voter_id", "voter_role", "consensus_mode"],
      "properties": {
        "voter_id": { "type": "string", "minLength": 1 },
        "voter_role": {
          "type": "string",
          "enum": ["primary_extractor", "secondary_extractor", "verifier"]
        },
        "consensus_mode": {
          "type": "string",
          "enum": ["single_voter_baseline"]
        }
      }
    },
    "document_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence"],
      "properties": {
        "value": { "type": "string", "enum": ["invoice"] },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "vendor_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "company_name",
        "address",
        "tax_ids",
        "website",
        "phone",
        "email"
      ],
      "properties": {
        "company_name": { "$ref": "#/$defs/company_name_field" },
        "address": { "$ref": "#/$defs/address" },
        "tax_ids": { "$ref": "#/$defs/tax_ids" },
        "website": { "$ref": "#/$defs/value_confidence_evidence" },
        "phone": { "$ref": "#/$defs/value_confidence_evidence" },
        "email": { "$ref": "#/$defs/value_confidence_evidence" }
      }
    },
    "invoice_header_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invoice_number", "invoice_date", "total_amount"],
      "properties": {
        "invoice_number": { "$ref": "#/$defs/value_confidence_evidence" },
        "invoice_date": { "$ref": "#/$defs/value_confidence_evidence" },
        "total_amount": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "currency", "confidence", "evidence"],
          "properties": {
            "value": { "type": ["number", "null"] },
            "currency": { "type": ["string", "null"] },
            "confidence": { "$ref": "#/$defs/confidence" },
            "evidence": { "$ref": "#/$defs/evidence_list" }
          }
        }
      }
    },
    "extraction_notes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "status": { "type": "string", "enum": ["success", "partial", "failure"] }
  },
  "$defs": {
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "evidence_list": {
      "type": "array",
      "items": { "type": "string", "pattern": "^p\\d+_[bl]\\d+$" }
    },
    "value_confidence_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "evidence"],
      "properties": {
        "value": { "type": ["string", "null"] },
        "confidence": { "$ref": "#/$defs/confidence" },
        "evidence": { "$ref": "#/$defs/evidence_list" }
      }
    },
    "company_name_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "present", "inferred", "confidence", "evidence"],
      "properties": {
        "value": { "type": ["string", "null"] },
        "present": { "type": "boolean" },
        "inferred": { "type": "boolean" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "evidence": { "$ref": "#/$defs/evidence_list" }
      }
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "street_1",
        "street_2",
        "city",
        "state",
        "postal_code",
        "country"
      ],
      "properties": {
        "street_1": { "$ref": "#/$defs/value_confidence_evidence" },
        "street_2": { "$ref": "#/$defs/value_confidence_evidence" },
        "city": { "$ref": "#/$defs/value_confidence_evidence" },
        "state": { "$ref": "#/$defs/value_confidence_evidence" },
        "postal_code": { "$ref": "#/$defs/value_confidence_evidence" },
        "country": { "$ref": "#/$defs/value_confidence_evidence" }
      }
    },
    "tax_ids": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ein", "state_tax_id", "vat_id", "other_tax_id"],
      "properties": {
        "ein": { "$ref": "#/$defs/value_confidence_evidence" },
        "state_tax_id": { "$ref": "#/$defs/value_confidence_evidence" },
        "vat_id": { "$ref": "#/$defs/value_confidence_evidence" },
        "other_tax_id": { "$ref": "#/$defs/value_confidence_evidence" }
      }
    }
  }
}
